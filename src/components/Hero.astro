---
interface Props { eyebrow: string; title: string; description: string; }
const { eyebrow, title, description } = Astro.props;
---
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <div class="button-row">
        <a class="button button--primary" href="#programmes">Découvrir les programmes</a>
        <a class="button button--outline" href="mailto:contact@tennismentorsclub.fr">Nous contacter</a>
      </div>
    </div>
    <div class="hero-panel">
      <span class="panel-line" aria-hidden="true"></span>
      <img src="/assets/images/tmc-logo.png" alt="Tennis Mentors Club" width="1501" height="621" fetchpriority="high" />
      <p>Accompagner<br />Soutenir<br />Faire grandir</p>
      <span class="tennis-ball" aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
  .hero { overflow: hidden; padding: clamp(4rem, 9vw, 7.5rem) 0; background: radial-gradient(circle at 15% 15%, rgb(199 245 0 / 14%), transparent 23%), linear-gradient(145deg, #fff 15%, #f2f6fb 100%); }
  .hero-grid { display: grid; grid-template-columns: 1.08fr 0.92fr; align-items: center; gap: clamp(2.5rem, 7vw, 6rem); }
  .hero-copy .lead { margin: 1.6rem 0 2rem; }
  .hero-panel { position: relative; display: flex; min-height: 31rem; flex-direction: column; justify-content: space-between; padding: clamp(2rem, 4vw, 3.5rem); overflow: hidden; color: white; background: linear-gradient(145deg, var(--color-navy), var(--color-navy-light)); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); isolation: isolate; }
  .hero-panel::before { position: absolute; inset: auto -12rem -14rem auto; z-index: -1; width: 30rem; height: 30rem; background: var(--color-blue); border-radius: 50%; content: ''; }
  .hero-panel img { width: min(100%, 18rem); padding: 1rem; background: white; border-radius: var(--radius-sm); }
  .hero-panel p { font-size: clamp(2rem, 5vw, 3.7rem); font-weight: 850; line-height: 1.02; letter-spacing: -0.045em; }
  .panel-line { position: absolute; top: 0; left: 3rem; width: 8rem; height: 0.45rem; background: var(--color-lime); }
  .tennis-ball { position: absolute; top: 2rem; right: 2rem; z-index: -1; width: 7rem; height: 7rem; background: var(--color-lime); border-radius: 50%; }
  @media (max-width: 850px) { .hero-grid { grid-template-columns: 1fr; } .hero-panel { min-height: 25rem; } }
  @media (max-width: 520px) { .hero-panel { min-height: 21rem; } .tennis-ball { width: 5rem; height: 5rem; } }
</style>
