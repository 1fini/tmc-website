---
interface Props { name: string; title: string; description: string; href: string; accent?: 'blue' | 'lime'; }
const { name, title, description, href, accent = 'blue' } = Astro.props;
---
<article class:list={['program-card', `program-card--${accent}`]}>
  <span>{name}</span>
  <h3>{title}</h3>
  <p>{description}</p>
  <a href={href}>Découvrir le programme <span aria-hidden="true">→</span></a>
</article>
<style>
  .program-card { position: relative; display: flex; min-height: 25rem; flex-direction: column; padding: clamp(1.7rem, 4vw, 2.7rem); overflow: hidden; background: white; border: 1px solid var(--color-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); }
  .program-card::before { position: absolute; inset: 0 0 auto; height: 0.45rem; background: var(--card-accent); content: ''; }
  .program-card--blue { --card-accent: var(--color-blue); }
  .program-card--lime { --card-accent: var(--color-lime); }
  .program-card > span { margin-bottom: auto; color: var(--color-blue); font-size: 0.75rem; font-weight: 850; letter-spacing: 0.14em; }
  h3 { margin-top: 3rem; font-size: clamp(1.7rem, 3vw, 2.45rem); }
  p { margin-top: 1rem; color: var(--color-muted); }
  a { margin-top: 2rem; color: var(--color-blue); font-weight: 850; text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: 0.3rem; }
</style>
