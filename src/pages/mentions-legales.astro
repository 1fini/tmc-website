---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Mentions légales | Tennis Mentors Club';
const description = 'Mentions légales du site officiel de Tennis Mentors Club.';
---
<BaseLayout {title} {description}>
  <header class="page-hero"><div class="container"><span class="eyebrow">Informations</span><h1>Mentions légales</h1></div></header>
  <section class="section"><div class="container prose">
    <h2>Éditeur du site</h2><p>Le site <a href="https://tennismentorsclub.fr">tennismentorsclub.fr</a> est édité par Tennis Mentors Club.</p><p>Contact : <a href="mailto:contact@tennismentorsclub.fr">contact@tennismentorsclub.fr</a></p>
    <h2>Hébergement</h2><p>Le site est hébergé par GitHub Pages, un service proposé par GitHub, Inc.</p>
    <h2>Propriété intellectuelle</h2><p>Les contenus et l’identité visuelle présents sur ce site sont protégés. Toute reproduction ou utilisation nécessite l’autorisation préalable de Tennis Mentors Club.</p>
    <h2>Données personnelles</h2><p>Le site ne propose pas de formulaire et ne dépose pas de cookie de suivi. Un contact initié par email est traité uniquement pour répondre à la demande adressée à l’association.</p><p>Pour toute question relative à vos données, écrivez à <a href="mailto:contact@tennismentorsclub.fr">contact@tennismentorsclub.fr</a>.</p>
    <h2>Liens externes</h2><p>Le site donne accès à des services externes, notamment Instagram, HelloAsso et Live Score. Leur consultation relève de leurs propres conditions d’utilisation et politiques de confidentialité.</p>
  </div></section>
</BaseLayout>
