---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProgramCard from '../components/ProgramCard.astro';
import CTA from '../components/CTA.astro';

const title = 'Tennis Mentors Club — Accompagner · Soutenir · Faire grandir';
const description = 'Tennis Mentors Club accompagne les jeunes joueurs et leurs familles avec des programmes, des ressources et des outils utiles.';
---
<BaseLayout {title} {description}>
  <Hero eyebrow="Association sportive" title="Grandir par le tennis, mieux entouré." description="Tennis Mentors Club accompagne les jeunes joueurs et leurs familles en facilitant l’accès au matériel, aux connaissances, aux outils et aux ressources utiles à leur progression." />

  <section class="section" aria-labelledby="mission-title">
    <div class="container mission-grid">
      <div>
        <span class="eyebrow">Notre mission</span>
        <h2 id="mission-title">Accompagner chaque parcours avec des réponses concrètes.</h2>
      </div>
      <div class="mission-copy">
        <p class="lead">Tennis Mentors Club est une association active et structurée autour d’une ambition : aider les jeunes joueurs et leur entourage à avancer dans de meilleures conditions.</p>
        <a href="/association">Découvrir l’association <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section id="programmes" class="section section--soft" aria-labelledby="programmes-title">
    <div class="container">
      <SectionHeading eyebrow="Nos programmes" title="Deux programmes, une même attention portée aux parcours." description="Des ressources accessibles pour mieux comprendre et mieux s’équiper, et un programme pilote pour soutenir de jeunes joueurs du Bas-Rhin." />
      <div class="program-grid">
        <ProgramCard name="MENTORSHIP ACCESS" title="Mieux s’équiper, mieux comprendre, mieux avancer." description="Un programme qui facilite l’accès au matériel, aux connaissances, aux outils et aux ressources nécessaires pour progresser dans de meilleures conditions." href="/programmes/mentorship-access" />
        <ProgramCard name="MENTORSHIP TALENTS" title="Accompagner une saison intensive." description="Un programme pilote 2026-2027 pour accompagner quatre jeunes joueurs du Bas-Rhin autour de l’entraînement, de l’équipement et des déplacements." href="/programmes/mentorship-talents" accent="lime" />
      </div>
    </div>
  </section>

  <section class="section section--navy" aria-labelledby="outils-title">
    <div class="container">
      <SectionHeading eyebrow="Services et outils" title="Des appuis utiles, sur le terrain et autour." description="Les actions de TMC s’organisent autour des besoins identifiés dans Mentorship Access et des outils mis à disposition de la communauté." />
      <div class="services-grid">
        <article><span>01</span><h3>Information</h3><p>Donner aux familles des repères pour mieux comprendre et décider.</p></article>
        <article><span>02</span><h3>Matériel et cordage</h3><p>Faciliter l’accès à l’équipement nécessaire pour jouer et progresser.</p></article>
        <article><span>03</span><h3>Transmission</h3><p>Former, partager les connaissances et rendre les ressources accessibles.</p></article>
        <article><span>04</span><h3>Communauté</h3><p>Créer une dynamique d’entraide entre jeunes, familles, clubs et soutiens.</p></article>
        <article class="live-card"><span>05</span><h3>Live Score</h3><p>Accéder à l’outil Live Score de Tennis Mentors Club.</p><a href="https://live.tennismentorsclub.fr" target="_blank" rel="noopener noreferrer">Ouvrir Live Score <span aria-hidden="true">↗</span></a></article>
      </div>
    </div>
  </section>

  <CTA title="Clubs, entreprises, mécènes et marques : agissons ensemble." description="Tennis Mentors Club souhaite créer des liens avec les structures qui veulent contribuer aux programmes et soutenir les jeunes joueurs et leurs familles." />
</BaseLayout>

<style>
  .mission-grid { display: grid; grid-template-columns: 1fr 0.8fr; align-items: end; gap: clamp(2.5rem, 8vw, 7rem); }
  .mission-copy .lead { margin-bottom: 1.6rem; }
  .mission-copy a { color: var(--color-blue); font-weight: 850; text-decoration: none; }
  .program-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.3rem; }
  .services-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 1rem; }
  .services-grid article { grid-column: span 2; padding: 1.7rem; background: rgb(255 255 255 / 6%); border: 1px solid rgb(255 255 255 / 13%); border-radius: var(--radius-md); }
  .services-grid article:nth-child(4), .services-grid article:nth-child(5) { grid-column: span 3; }
  .services-grid article > span { color: var(--color-lime); font-size: 0.78rem; font-weight: 900; }
  .services-grid h3 { margin-top: 2.5rem; }
  .services-grid p { margin-top: 0.7rem; color: rgb(255 255 255 / 70%); }
  .services-grid a { display: inline-block; margin-top: 1.2rem; color: var(--color-lime); font-weight: 800; text-decoration: none; }
  .live-card { background: var(--color-blue) !important; }
  .live-card > span, .live-card p { color: white !important; }
  .live-card a { padding: 0.55rem 0.8rem; color: var(--color-navy); background: var(--color-lime); border-radius: 999px; }
  @media (max-width: 850px) { .mission-grid, .program-grid { grid-template-columns: 1fr; } .services-grid article, .services-grid article:nth-child(4), .services-grid article:nth-child(5) { grid-column: span 3; } }
  @media (max-width: 600px) { .services-grid { grid-template-columns: 1fr; } .services-grid article, .services-grid article:nth-child(4), .services-grid article:nth-child(5) { grid-column: auto; } }
</style>
