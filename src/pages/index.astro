---
const title = 'Tennis Mentors Club';
const description = 'Tennis Mentors Club accompagne les jeunes compétiteurs, leurs familles et les clubs avec des ressources, des actions de terrain et des outils concrets.';
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0b2d52" />
  <title>{title}</title>
  <style>
    :root{--navy:#0b2d52;--blue:#0057ff;--lime:#c8f000;--ink:#24364a;--muted:#65758b;--soft:#f4f7fb;--line:#dfe7ef;--white:#fff;--shadow:0 18px 55px rgba(11,45,82,.12);--radius:24px;--max:1180px}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:#fff;line-height:1.6}a{color:inherit}.container{width:min(calc(100% - 40px),var(--max));margin-inline:auto}.eyebrow{display:inline-flex;align-items:center;gap:.55rem;font-size:.78rem;letter-spacing:.16em;text-transform:uppercase;font-weight:800;color:var(--blue)}.eyebrow:before{content:"";width:28px;height:3px;border-radius:3px;background:var(--lime)}h1,h2,h3{color:var(--navy);line-height:1.08;margin:0}h1{font-size:clamp(2.7rem,6vw,5.7rem);letter-spacing:-.055em}h2{font-size:clamp(2rem,4vw,3.8rem);letter-spacing:-.045em}h3{font-size:1.25rem}.lead{font-size:clamp(1.05rem,1.7vw,1.3rem);color:var(--muted);max-width:760px}.btns{display:flex;flex-wrap:wrap;gap:12px}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 22px;border-radius:999px;text-decoration:none;font-weight:800;transition:.2s ease;border:1px solid transparent}.btn-primary{background:var(--navy);color:#fff}.btn-primary:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(11,45,82,.2)}.btn-secondary{background:#fff;border-color:var(--line);color:var(--navy)}.btn-secondary:hover{border-color:var(--blue);color:var(--blue)}section{padding:94px 0}.grid{display:grid;gap:22px}.cards{grid-template-columns:repeat(3,1fr)}.card{padding:30px;border:1px solid var(--line);border-radius:var(--radius);background:#fff;box-shadow:0 9px 30px rgba(11,45,82,.06)}.card p{color:var(--muted)}.tag{display:inline-block;padding:7px 11px;border-radius:999px;background:rgba(200,240,0,.28);font-size:.77rem;font-weight:900;color:var(--navy);margin-bottom:18px}.section-head{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:38px}.section-head p{margin:0;max-width:520px;color:var(--muted)}
    header{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.92);backdrop-filter:blur(14px);border-bottom:1px solid rgba(223,231,239,.85)}.nav{min-height:78px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{display:flex;align-items:center;gap:12px;text-decoration:none}.brand-mark{display:grid;place-items:center;width:46px;height:46px;border-radius:50%;background:var(--navy);color:var(--lime);font-weight:900}.brand-name{font-weight:900;color:var(--navy)}.navlinks{display:flex;gap:24px;align-items:center}.navlinks a{text-decoration:none;font-weight:750;font-size:.93rem}.navlinks a:hover{color:var(--blue)}
    .hero{padding:84px 0 72px;overflow:hidden;background:radial-gradient(circle at 90% 0%,rgba(0,87,255,.12),transparent 28%),linear-gradient(180deg,#fff 0%,#f8fbff 100%)}.hero-grid{display:grid;grid-template-columns:1.15fr .85fr;align-items:center;gap:55px}.hero p{margin:25px 0 30px}.hero-visual{position:relative;min-height:500px;border-radius:38px;background:linear-gradient(145deg,var(--navy),#154f86);box-shadow:var(--shadow);overflow:hidden;padding:44px;display:flex;flex-direction:column;justify-content:space-between}.hero-visual:before{content:"";position:absolute;width:330px;height:330px;border-radius:50%;background:var(--lime);right:-110px;top:-120px}.hero-visual>*{position:relative;z-index:2}.hero-logo{display:flex;align-items:center;gap:16px;background:#fff;border-radius:22px;padding:18px 22px;width:max-content}.hero-logo span{display:grid;place-items:center;width:72px;height:72px;border-radius:50%;background:var(--navy);color:var(--lime);font-weight:900;font-size:1.2rem}.hero-logo strong{color:var(--navy);font-size:1.05rem;max-width:130px;line-height:1.1}.hero-quote{color:#fff;font-size:1.45rem;line-height:1.25;font-weight:750;max-width:420px}.hero-note{color:rgba(255,255,255,.7);font-size:.9rem}
    .stats{padding:0 0 40px}.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);background:#fff;border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow);overflow:hidden}.stat{padding:25px 28px;border-right:1px solid var(--line)}.stat:last-child{border-right:0}.stat strong{display:block;color:var(--navy);font-size:1.7rem}.stat span{font-size:.9rem;color:var(--muted)}.programs{background:var(--soft)}.program-card a{display:inline-block;margin-top:18px;font-weight:850;text-decoration:none;color:var(--blue)}
    .mission-grid{grid-template-columns:.85fr 1.15fr;align-items:start}.mission-box{background:var(--navy);color:#fff;border-radius:30px;padding:38px}.mission-box h2,.mission-box p{color:#fff}.mission-list{display:grid;gap:18px}.mission-item{display:grid;grid-template-columns:46px 1fr;gap:18px;padding:24px;border-bottom:1px solid var(--line)}.number{width:46px;height:46px;border-radius:50%;display:grid;place-items:center;background:rgba(0,87,255,.1);color:var(--blue);font-weight:900}.cta{padding:65px 0 100px}.cta-box{padding:50px;border-radius:32px;background:linear-gradient(130deg,var(--navy),#164d80);color:#fff;display:flex;align-items:center;justify-content:space-between;gap:30px}.cta-box h2,.cta-box p{color:#fff}.cta-box .btn-primary{background:var(--lime);color:var(--navy)}footer{background:#071f39;color:rgba(255,255,255,.78);padding:44px 0}.footer-grid{display:flex;justify-content:space-between;align-items:center;gap:30px}.footer-links{display:flex;gap:20px;flex-wrap:wrap}.footer-links a{text-decoration:none}
    @media(max-width:900px){.navlinks{display:none}.hero-grid,.mission-grid{grid-template-columns:1fr}.hero-visual{min-height:410px}.cards{grid-template-columns:1fr}.stats-grid{grid-template-columns:1fr 1fr}.section-head,.cta-box,.footer-grid{align-items:flex-start;flex-direction:column}}@media(max-width:560px){.container{width:min(calc(100% - 26px),var(--max))}.brand-name{display:none}.hero{padding-top:55px}.hero-visual{padding:28px;min-height:340px}.stats-grid{grid-template-columns:1fr}.stat{border-right:0;border-bottom:1px solid var(--line)}section{padding:70px 0}.cta-box{padding:34px 26px}}
  </style>
</head>
<body>
<header><div class="container nav"><a class="brand" href="/"><span class="brand-mark">TMC</span><span class="brand-name">Tennis Mentors Club</span></a><nav class="navlinks"><a href="#association">L'association</a><a href="#programmes">Programmes</a><a href="#agir">Nous soutenir</a><a href="mailto:contact@tennismentorsclub.fr">Contact</a></nav></div></header>
<main>
<section class="hero"><div class="container hero-grid"><div><span class="eyebrow">Association sportive et solidaire</span><h1>Mieux entourer les jeunes qui veulent grandir par le tennis.</h1><p class="lead">Tennis Mentors Club accompagne les jeunes compétiteurs et leurs familles avec des repères, du matériel, des ressources et des actions concrètes, au plus près des clubs.</p><div class="btns"><a class="btn btn-primary" href="#programmes">Découvrir nos programmes</a><a class="btn btn-secondary" href="mailto:contact@tennismentorsclub.fr">Nous contacter</a></div></div><div class="hero-visual"><div class="hero-logo"><span>TMC</span><strong>Tennis Mentors Club</strong></div><div><div class="hero-quote">« Donner aux familles les moyens de mieux comprendre, mieux s’équiper et mieux avancer. »</div><div class="hero-note">Accompagner · Soutenir · Faire grandir</div></div></div></div></section>
<div class="stats"><div class="container stats-grid"><div class="stat"><strong>2</strong><span>programmes structurants</span></div><div class="stat"><strong>5</strong><span>axes d’accompagnement</span></div><div class="stat"><strong>1</strong><span>communauté de familles et de clubs</span></div><div class="stat"><strong>100 %</strong><span>orienté terrain et transmission</span></div></div></div>
<section id="programmes" class="programs"><div class="container"><div class="section-head"><div><span class="eyebrow">Nos programmes</span><h2>Deux réponses complémentaires.</h2></div><p>Des actions accessibles pour les familles et un accompagnement renforcé pour les jeunes talents.</p></div><div class="grid cards"><article class="card program-card"><span class="tag">MENTORSHIP ACCESS</span><h3>Mieux s’équiper, mieux comprendre, mieux avancer.</h3><p>Matériel, cordage, ateliers, ressources pratiques, outils numériques et communauté d’entraide.</p><a href="mailto:contact@tennismentorsclub.fr?subject=Plaquette%20Mentorship%20Access">Recevoir la plaquette →</a></article><article class="card program-card"><span class="tag">MENTORSHIP TALENTS</span><h3>Accompagner les parcours à fort potentiel.</h3><p>Un programme pensé pour structurer l’entourage, mobiliser des partenaires et soutenir la progression.</p><a href="mailto:contact@tennismentorsclub.fr?subject=Plaquette%20Mentorship%20Talents">Recevoir la plaquette →</a></article><article class="card program-card"><span class="tag">OUTILS TMC</span><h3>Des services utiles au quotidien.</h3><p>Live scoring, ressources centralisées, suivi matériel et contenus pratiques pour les familles et les clubs.</p><a href="https://live.tennismentorsclub.fr">Accéder au Live Score →</a></article></div></div></section>
<section id="association"><div class="container grid mission-grid"><aside class="mission-box"><span class="eyebrow">Notre raison d’être</span><h2>Le tennis ne se construit pas seul.</h2><p>Nous créons des passerelles entre jeunes, familles, clubs, mentors et partenaires pour que l’information, le matériel ou l’isolement ne deviennent pas des freins.</p></aside><div class="mission-list"><div class="mission-item"><div class="number">01</div><div><h3>Accompagner</h3><p>Partager les repères utiles sur la compétition, le matériel, la saison et le rôle de l’entourage.</p></div></div><div class="mission-item"><div class="number">02</div><div><h3>Soutenir</h3><p>Faciliter l’accès aux équipements, aux services de proximité et aux partenariats.</p></div></div><div class="mission-item"><div class="number">03</div><div><h3>Faire grandir</h3><p>Développer l’autonomie, la confiance et la capacité des jeunes et de leurs familles à avancer durablement.</p></div></div></div></div></section>
<section id="agir" class="cta"><div class="container cta-box"><div><h2>Entreprises, clubs, mentors : construisons la suite ensemble.</h2><p>Partenariat financier, matériel, expertise ou mise à disposition de moyens.</p></div><div class="btns"><a class="btn btn-primary" href="mailto:contact@tennismentorsclub.fr?subject=Partenariat%20TMC">Devenir partenaire</a><a class="btn btn-secondary" href="https://www.helloasso.com/associations/tennis-mentors-club" target="_blank" rel="noreferrer">Soutenir l’association</a></div></div></section>
</main>
<footer><div class="container footer-grid"><div><strong>Tennis Mentors Club</strong><br/>Accompagner · Soutenir · Faire grandir</div><div class="footer-links"><a href="mailto:contact@tennismentorsclub.fr">contact@tennismentorsclub.fr</a><a href="https://www.instagram.com/tennismentorsclub/" target="_blank" rel="noreferrer">Instagram</a></div></div></footer>
</body>
</html>
