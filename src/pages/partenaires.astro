---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
const title = 'Partenaires | Tennis Mentors Club';
const description = 'Clubs, entreprises, mécènes et marques peuvent contribuer aux programmes de Tennis Mentors Club.';
---
<BaseLayout {title} {description}>
  <header class="page-hero"><div class="container"><span class="eyebrow">Partenaires</span><h1>Construire des soutiens utiles autour des jeunes joueurs.</h1><p class="lead">Tennis Mentors Club souhaite associer clubs, entreprises, mécènes et marques au développement de ses programmes et de ses outils.</p></div></header>
  <section class="section"><div class="container feature-grid"><article class="feature-card"><h2>Clubs</h2><p>Échanger autour des besoins des jeunes joueurs et de leurs familles.</p></article><article class="feature-card"><h2>Entreprises et mécènes</h2><p>Contribuer au financement des programmes et de leurs objectifs de collecte.</p></article><article class="feature-card"><h2>Marques</h2><p>Faciliter l’accès au matériel et aux ressources utiles aux parcours.</p></article></div></section>
  <CTA title="Parlons de votre contribution." description="Chaque échange commence par une prise de contact avec Tennis Mentors Club." />
</BaseLayout>
<style>.feature-card h2 { font-size: clamp(1.55rem, 3vw, 2.15rem); }</style>
